#the mod name as displayed in-game
displayName: "Sector Logic"

#the internal name of your mod
name: "sector-logic"

subtitle: "Managing sector exports and imports in Serpulo campaign",

#your name
author: "cardillan"

#the fully qualified main class of the mod
main: "cardillan.sectors.Main"

#the mod description as seen in the mod dialog
description: "Provides custom mlog instructions for managing sector exports and imports in Serpulo campaign."

#the mod version
version: 0.1.1

#the minimum game build required to run this mod
minGameVersion: 154

#this is a java mod
java: true
